    try:
        await interaction.followup.send(
            content=f"Here is the CSV file with Junior Director+ users' IDs ({amount_of_ids} users):",
            ephemeral=True,
            file=file,
        )

        logger.info("CSV Junior Director+ command executed successfully.")
    except Exception as e:
        logger.error(f"Error sending CSV file: {e}")
        try:
            await interaction.followup.send(
                content="❌ Error sending CSV file.", ephemeral=True
            )
        except Exception as e:
