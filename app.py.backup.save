pickup = True

ALL_RANKS = []
ALL_RANKS.extend(LOW_RANKS)
ALL_RANKS.extend(MID_RANKS)
ALL_RANKS.extend(HIGH_RANKS)

LOW_HIGH_RANKS = []
LOW_HIGH_RANKS.extend(LOW_RANKS)
LOW_HIGH_RANKS.extend(MID_RANKS)

async def monitor_role_changes(allowed_rank_names=ALL_RANKS):
    asyncio.create_task(
        safe_send(
            "🧼 Starting a new monitoring loop... All alright I think? *informs <@1114892999474815126>*",
            TIME_TRACKING_CHANNEL_ID,
        )
    )

    async with aiohttp.ClientSession() as session:
        file_path = "pickup_last_checking.txt"

        pickup = False
        if os.path.exists(file_path):
            with open(file_path, "r", encoding="utf-8") as f:
                last_checking = f.read().strip()
                logger.info(f"Last checking was at: {last_checking}")
                pickup = True
                pickup_rank = last_checking
        else:
            print(f"{file_path} does not exist.")

        while True:
            times = {}
            start_time = time.time()
            logger.info("🔎 Checking for role changes...")

            csv_jdplus_str_in_progress = ""

            logger.info("Fetching roles from Roblox API...")
            roles = await fetch_roles(session, GROUP_ID)
            if not roles:
                logger.debug(
                    "No roles found or failed to fetch roles. Retrying in 10 seconds..."
                )
                await asyncio.sleep(10)
                continue

            logger.debug(f"Fetched {len(roles)} roles from Roblox API.")

            all_changes_loop = {}

            roles_dict = {role["id"]: role["name"] for role in roles}
            data = await load_data()

            roles_processed = 0
            users_checked = 0

            logger.debug("Starting role change checks, for-loop for roles.")
            total_roles = len(roles)
            for i_roles, role in enumerate(roles, start=1):
                if pickup:
                    if role["name"] != pickup_rank:
                        logger.info(
                            f"Skipping role {role['name']} until we reach pickup."
                        )
                        continue
                    else:
                        logger.info(
                            f"Reached pickup rank: {pickup_rank}. Resuming checks."
                        )
                        pickup = False
                        # Remove the pickup file after reaching the rank
                        if os.path.exists(file_path):
                            os.remove(file_path)
                            logger.info(f"Removed pickup file: {file_path}")
                
                #if not role["name"] in allowed_rank_names:
                    # logger.debug(f"Role was not allowed on this instance of monitoring. Skipping.")
                    #continue    

                cur_role_start = time.monotonic()

                with open("pickup_last_checking.txt", "w", encoding="utf-8") as f:
                    f.write(role["name"])

                all_changes_role = []

                logger.info(
                    f"Starting the loop for {role['name']} with ID {role['id']}."
                )

                await bot.change_presence(
                    activity=discord.Game(f"Monitoring role changes: {role['name']}")
                )

                # Queued send - queue messages to max chars to limit messages sent.
                enable_queued_send = role["name"] not in HIGH_RANKS
                queue = ""

                logger.debug(
                    f"Fetching users for role {role['name']} with ID {role['id']}."
                )
                users = await fetch_users_in_role(
                    session, GROUP_ID, role["id"], role_member_count=role["memberCount"]
                )
                logger.debug("Starting role change checks, for-loop for users.")
                total_users = len(users)
                for i_users, user in enumerate(users, start=1):
                    logger.debug(
                        f"[U {i_users}/{total_users}] Processing {user['username']} with ID {user['userId']}. [R {i_roles}/{total_roles}]"
                    )

                    user_id = str(user["userId"])
                    current_rank = role["name"]
                    current_index = get_rank_index(current_rank)

                    if role["name"] in HIGH_RANKS:
                        include_comma = "" if csv_jdplus_str_in_progress == "" else ","
                        csv_jdplus_str_in_progress = (
                            f"{csv_jdplus_str_in_progress}{include_comma}{user_id}"
                        )
                        logger.debug(
                            f"Added {user['username']} ({user_id}) to Junior Director+ CSV string."
                        )
                        logger.debug(
                            f"Current CSV string length: {len(csv_jdplus_str_in_progress)}"
                        )

                    if user_id in data["user_roles"]:
                        prev_role_id = data["user_roles"][user_id]
                        prev_role_name = roles_dict.get(prev_role_id, "Unknown")
                        prev_index = get_rank_index(prev_role_name)

                        # logger.debug(f"Promotion Check: {user["username"]}")
                        # logger.debug(f"has_proper_rank_index  {current_index != -1}")
                        # logger.debug(f"prev_rank_proper_index {prev_index != -1}")
                        # logger.debug(f"Changes: {current_index != prev_index}")

                        if (
                            current_index != -1
                            and prev_index != -1
                            and current_index != prev_index
                        ):

                            action = (
                                "promoted" if current_index > prev_index else "demoted"
                            )
                            channel_id, mention = get_rank_category_and_mention(
                                current_rank
                            )

                            # log_in_mt_too = False
                            prev_channel_id, prev_mention = (
                                get_rank_category_and_mention(prev_role_name)
                            )

                            if (
                                prev_channel_id == JUNIOR_DIRECTOR_CHAIRMAN_CHANNEL
                                and action == "demoted"
                            ):
                                channel_id = JUNIOR_DIRECTOR_CHAIRMAN_CHANNEL

                            if channel_id:
                                channel = bot.get_channel(channel_id)

                                if not isinstance(channel, discord.TextChannel):
                                    channelid = ""

                                    if channel is not None and hasattr(channel, "id"):
                                        channelid = channel.id

                                    logger.exception(
                                        f"Channel {channelid} is not a TextChannel."
                                    )

                                if isinstance(channel, (discord.TextChannel)):
                                    profile_link = f"[{user['username']}](<https://www.roblox.com/users/{user['userId']}/profile>)"
                                    message = f"{profile_link} has been {action} from {prev_role_name} to {current_rank} {mention}"

                                    message_obj = None

                                    if enable_queued_send:
                                        if (
                                            len(queue) + len(message)
                                            > MAX_CHARS_DISCORD
                                        ):
                                            logger.info(
                                                f"📢 Releasing (aka sending) queued message to {channel.name} ({channel.id})"
                                            )
                                            asyncio.create_task(
                                                safe_send(queue, channel=channel)
                                            )
                                            queue = ""
                                        queue += message + "\n"
                                        logger.debug(f"Queued message: {message}")

                                        if user == users[-1]:
                                            asyncio.create_task(
                                                safe_send(queue, channel=channel)
                                            )
                                    else:
                                        asyncio.create_task(
                                            safe_send(queue, channel=channel)
                                        )

                                    logger.info(f"📢 {message}")

                                    rank_map = {
                                        **dict.fromkeys(LOW_RANKS, "Low"),
                                        **dict.fromkeys(MID_RANKS, "Mid"),
                                        **dict.fromkeys(HIGH_RANKS, "High"),
                                    }

                                    staff_team = rank_map.get(current_rank, "Unknown")

                                    change = {
                                        "user": user["username"],
                                        "userId": user["userId"],
                                        "action": action,
                                        "from": prev_role_name,
                                        "to": current_rank,
                                        "mention": mention,
                                        "message_id": getattr(message_obj, "id", None),
                                        "channel_id": getattr(channel, "id", None),
                                        "timestamp_discovered_change": time.time(),
                                        "staff_team": staff_team,
                                    }

                                    # asyncio.create_task(user_rank_history.update_user_history(
                                    #     str(user_id), change
                                    # ))

                                    all_changes_loop.setdefault(staff_team, []).append(
                                        change
                                    )
                                    all_changes_role.append(change)
                                else:
                                    logger.exception(
                                        f"Channel {getattr(channel, 'name', None)} ({getattr(channel, 'id', None)}) is not a TextChannel or NewsChannel."
                                    )
                    data["user_roles"][user_id] = role["id"]
                    users_checked += 1

                    # asyncio.create_task(user_rank_history.ensure_user_exists(user_id, user["username"], current_rank))
                roles_processed += 1
                cur_role_end = time.monotonic()
                cur_role_time_taken = cur_role_end - cur_role_start
                times[role["name"]] = cur_role_time_taken

            await save_data(data)
            end_time = time.time()
            duration = end_time - start_time

            with open(
                "app_changes_log.json", "w", encoding="utf-8"
            ) as changes_log_file:
                json.dump(
                    all_changes_loop,
                    changes_log_file,
                    ensure_ascii=False,
                    indent=2,
                )

            summary = (
                f"## 📊 **Cycle Summary**\n"
                f"* ✅ Processed {roles_processed}/{len(roles)} roles.\n"
                f"* 👥 Checked **{users_checked}** user entries.\n"
                f"* ⏱ Time taken: **{duration:.2f} seconds**.\n"
                f"* 🕐 Started at <t:{int(start_time)}:T>, ended at <t:{int(end_time)}:T>."
                "-# Ping: <@1114892999474815126>"
            )
            time_channel = bot.get_channel(TIME_TRACKING_CHANNEL_ID)
            if time_channel and isinstance(time_channel, discord.TextChannel):
                asyncio.create_task(safe_send(summary, channel=time_channel))

            file_path = "pickup_last_checking.txt"

            if os.path.exists(file_path):
                os.remove(file_path)
                print(f"{file_path} has been deleted.")
            else:
                print(f"{file_path} does not exist.")
            pickup = False

            logger.info("✅ Cycle complete.")

            # print("\n"+csv_jdplus_str_in_progress+"\n")

            csv_jdplus_str = csv_jdplus_str_in_progress
            csv_jdplus_str_in_progress = ""

            logger.debug(times)

            latest_app_hash = hashlib.sha256(open("app.py", "rb").read()).hexdigest()

            # with open("app_changes_log.json", "w", encoding="utf-8") as changes_log_file:
            #     json.dump(all_changes_loop, changes_log_file, ensure_ascii=False, indent=2)
            # Hiya +345787877878787878787

            shutdown_scheduled = False

            if latest_app_hash != APP_FILE_HASH:
                logger.info("App file has changed. Restarting bot...")
                shutdown_scheduled = True
                time_channel = bot.get_channel(TIME_TRACKING_CHANNEL_ID)
                if time_channel and isinstance(time_channel, discord.TextChannel):
                    asyncio.create_task(
                        safe_send(
                            f"# 🔄 App file changed, bot will shutdown. \n We are at the end of the monitor role changes loop, will shutdown..."
                        ),
                        channel=time_channel,
                    )

            if shutdown_scheduled:
                logger.info("Shutdown scheduled. Closing bot...")
                await bot.close()
                logger.info("Shutdown scheduled. Exiting monitor loop.")
                break

            await asyncio.sleep(180)  # Check every 3 minutes


async def safe_monitor_wrapper():
    while True:
        if True: # try:
            await monitor_role_changes()
        # except (KeyboardInterrupt, SystemExit):
        #     logger.info("Shutdown signal received. Exiting monitor loop.")
        #     logger.info("saving data before exit...")
        #     save_data(data)
        #     break
        # except Exception as e:
        #     logger.error(f"‼️ monitor_role_changes crashed: {e}")
        #     await asyncio.sleep(10)


@bot.event
async def on_ready():
    get_latest_git_commitid = None
    try:
        import get_latest_git_commitid
    except (ImportError, NameError) as e:
        logger.error(
            f"Failed to import get_latest_git_commitid: {e}\n You may ignore this error."
        )

    if not bot.user:
        logger.error("Bot user is not set. Exiting.")
        sys.exit(1)

    logger.info(f"Logged in as {bot.user.name}")
    await bot.change_presence(activity=discord.Game("Monitoring role changes"))
    try:
        if get_latest_git_commitid is not None:
            APP_FILE_GIT_HASH = get_latest_git_commitid.get_latest_commit(
                "app.py", short=True
            )
        else:
            APP_FILE_GIT_HASH = "N/A"
    except Exception as e:
        logger.error(f"Failed to get latest git commit: {e}")
        APP_FILE_GIT_HASH = "N/A"

    print("\n\n")
    logger.info(Fore.GREEN + "WELCOME TO RANKSPY!" + Style.RESET_ALL)
    logger.info(attribution)
    # logger.info("Latest Version: N/A")
    logger.info(
        f"Latest Git Commit ID for app.py: {APP_FILE_GIT_HASH} + Further non-commited revisions."
    )
    logger.info(f"App file hash: {APP_FILE_HASH}")
    print("\n\n")

    try:
        # Sync the command tree globally
        await bot.sync_commands()

        print("Command tree synced globally!")
    except Exception as e:
        print(f"Failed to sync command tree: {e}")

    logger.info("Starting monitor_role_changes task...")
    bot.loop.create_task(safe_monitor_wrapper())
    # bot.loop.create_task(user_rank_history.history_writer())


if __name__ == "__main__":
    if TOKEN is None:
        logger.error("DISCORD_BOT_TOKEN not set in .env file.")
        sys.exit(1)
    try:
        bot.run(TOKEN)
    except Exception as e:
        logger.error(f"Error running bot: {e}")

