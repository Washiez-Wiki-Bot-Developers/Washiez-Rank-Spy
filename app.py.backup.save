async def safe_send(
    message: str,
    channel_id: Optional[int] = None,
    channel: Optional[
        Union[discord.TextChannel, discord.Thread, discord.DMChannel]
    ] = None,
    bot: Optional[discord.Client] = bot,
    message_critical: Union[True, False] = True,
) -> Optional[Union[discord.Message, False]]:
    """
    Safely send a message to a channel with retries.

    - Retries indefinitely for connection/HTTP issues.
    - Retries up to 3 times for Forbidden errors.
    - Works in both discord.py and Pycord.
    """

    if channel is None:
        if bot is None or channel_id is None:
            raise ValueError("Must provide either channel or (bot and channel_id).")
        channel = bot.get_channel(channel_id)
        if channel is None:
            raise ValueError(f"Channel with ID {channel_id} not found.")

    forbidden_attempts = 0
    attempts = 0

    while True:
        try:
            return await channel.send(message)
        except discord.Forbidden as e:
            forbidden_attempts += 1
            
            # if os.getenv('ENVIRONMENT_MODE') == 'local_debug':
            #     logger.debug(f"safe_send: Forbidden when attempting to send. Understood it's {str(os.getenv('ENVIROMENT_MODE'))}. Will ignore.")
            #     return True
            
            logger.error(f"safe_send: Forbidden (attempt {forbidden_attempts}) - {e}")
            if forbidden_attempts >= 3:
                logger.error("safe_send: Giving up after 3 Forbidden attempts.")
                return False
            await asyncio.sleep(2)  # small backoff before retry
        except (discord.HTTPException, discord.ConnectionClosed, OSError) as e:
            logger.warning(f"safe_send: transient error, retrying - {e}")
            attempts += 1
            
            if not message_critical and attempts >= 5:
                logger.warning(
                    "safe_send: Attempting to safely send messages has failed. Function returning False."
                )
                return False
            await asyncio.sleep(2)  # backoff before retry
        except Exception as e:
            logger.exception(f"safe_send: unexpected error - {e}")
            attempts += 1
            if not message_critical and attempts >= 5:
                logger.warning(
                    "safe_send: Attempting to safely send messages has failed. Function returning False."
                )
                return False


async def convert_to_simplified(data):
    user_roles = data["user_roles"]

    # Create unique role IDs
    unique_roles = list(dict.fromkeys(user_roles.values()))  # preserves order
    role_map = {
        letter: role_id for letter, role_id in zip(ascii_uppercase, unique_roles)
    }

    # Invert role_map for lookup
    reverse_map = {v: k for k, v in role_map.items()}

    # Replace role IDs with shorthand
    simplified_user_roles = {
        user: reverse_map[role] for user, role in user_roles.items()
    }

    # Final structure
    simplified = {"role_map": role_map, "user_roles": simplified_user_roles}
    return simplified

async def convert_from_simplified(simplified_data):
    role_map = simplified_data["role_map"]
    user_roles = simplified_data["user_roles"]

    expanded_user_roles = {
        user: role_map[shorthand] for user, shorthand in user_roles.items()
    }

    expanded = {"user_roles": expanded_user_roles}
    return expanded

async def load_data(file_name: str = DATA_FILE):
    async with file_lock:
        try:
            async with aiofiles.open(file_name, "r", encoding="utf-8") as file:
                contents = await file.read()
                data = json.loads(contents)   # string → dict
                if "role_map" in data:        # already simplified
                    data = await convert_from_simplified(data)
                return data
        except (FileNotFoundError, json.JSONDecodeError):
            logger.info("Data file missing or corrupt. Creating fresh.")
            return {"user_roles": {}}


async def save_data(data, file_name: str = DATA_FILE):
    async with file_lock:
        try:
            data["epoch_last_edited"] = time.time()
            simplified = await convert_to_simplified(data)
            async with aiofiles.open(file_name, "w", encoding="utf-8") as f:
                await f.write(json.dumps(simplified, ensure_ascii=False, indent=2))
            logger.info("Data saved.")
        except Exception as e:
            logger.error(f"Failed saving data: {e}")

data = asyncio.run(load_data())


def get_rank_category_and_mention(rank_name):
    if rank_name in LOW_RANKS:
        return CUSTOMER_HEAD_OP_CHANNEL, LOW_RANK_ROLE_MENTION
    elif rank_name in MID_RANKS:
        return SHIFT_LEADER_GEN_MANAGER_CHANNEL, MID_RANK_ROLE_MENTION
    elif rank_name in HIGH_RANKS:
        return JUNIOR_DIRECTOR_CHAIRMAN_CHANNEL, HIGH_RANK_ROLE_MENTION
    return None, None


def get_rank_index(rank_name):
    if rank_name in LOW_RANKS:
        return LOW_RANKS.index(rank_name)
    elif rank_name in MID_RANKS:
        return len(LOW_RANKS) + MID_RANKS.index(rank_name)
    elif rank_name in HIGH_RANKS:
        return len(LOW_RANKS) + len(MID_RANKS) + HIGH_RANKS.index(rank_name)
    return -1


async def retrieve_roproxy_url(url):
    url = url.replace("roblox.com", "roproxy.com")
    return url


async def fetch_roles(session, group_id):
    base_url = f"https://groups.roblox.com/v1/groups/{group_id}/roles"
    try:
        async with session.get(
            base_url, timeout=aiohttp.ClientTimeout(total=10)
        ) as response:
            if response.status == 429:
                # Rate limited — switch to RoProxy
                roproxy_url = retrieve_roproxy_url(base_url)
                logger.warning(f"Rate limited. Retrying with RoProxy: {roproxy_url}")
                async with session.get(
                    roproxy_url, timeout=aiohttp.ClientTimeout(total=10)
                ) as proxy_response:
                    if proxy_response.status != 200:
                        logger.error(f"RoProxy failed: {proxy_response.status}")
                        return []
                    data = await proxy_response.json()
                    return data.get("roles", [])
            elif response.status != 200:
                logger.error(f"Failed to fetch roles: {response.status}")
                return []
            data = await response.json()
            return data.get("roles", [])
    except Exception as e:
        logger.error(f"Error fetching roles: {e}")
        return []


async def pickup_get(rank):
    with open("pickup.txt", "r", encoding="utf-8") as f:
        return f.read().strip()


async def pickup_get_safe(rank):
    try:
        pickup_obj = pickup_get(rank)
    except (FileNotFoundError, json.JSONDecodeError) as e:
        logger.error(f"Error reading pickup file: {e}")
        return None

    if pickup_obj is None:
        return None

    if pickup_obj["epoch_last_operation"] + 300 < time.time():
        return None


async def pickup_set(value, rank):
    with open("pickup.txt", "w", encoding="utf-8") as f:
        obj = {"epoch_last_operation": time.time(), rank: value}

        f.write(json.dumps(obj))


async def fetch_users_in_role(session, group_id, role_id, role_member_count="?"):
    users = []
    cursor = ""
    logger.debug(f"Fetching users for role {role_id} in group {group_id}.")

    time_start = time.time()
    elapsed_time = 0.0

    from rich.progress import Progress, TextColumn, BarColumn, TimeElapsedColumn

    # Create the progress bar ONCE
    with Progress(
        TextColumn(
            f"Fetched {{task.completed}}/{{task.total}} ({{task.percentage:>3.0f}}%) users for role {role_id}"
        ),
        BarColumn(),
        TextColumn("[{task.fields[ups]} u/s]"),
        TextColumn("({task.fields[time_remaining]} left)"),
        TimeElapsedColumn(),
        refresh_per_second=5,
        transient=True,  # hides when done
    ) as progress:

        total_count = (
            int(role_member_count) if role_member_count not in (None, "?") else 0
        )
        task = progress.add_task(
            "Fetching", total=total_count, ups="0", time_remaining="?"
        )

        while True:
            url = f"https://groups.roblox.com/v1/groups/{group_id}/roles/{role_id}/users?limit=100&sortOrder=Asc"
            if ENABLE_ROPROXY_USAGE_FIRST_PRIORITY:
                url = await retrieve_roproxy_url(url)

            if cursor:
                url += f"&cursor={cursor}"

            try:
                async with session.get(
                    url, timeout=aiohttp.ClientTimeout(total=10)
                ) as response:
                    if response.status != 200:
                        logger.error(
                            f"Failed to fetch users for role {role_id}: {response.status}"
                        )
                        return users

                    data = await response.json()

                    if response.status == 429:
                        logger.warning(
                            f"Rate limited on Roblox API for role {role_id}."
                        )

                        async with session.get(
                            url, timeout=aiohttp.ClientTimeout(total=10)
                        ) as response:
                            # Rate limited — switch to RoProxy
                            roproxy_url = retrieve_roproxy_url(url)
                            logger.warning(
                                f"Rate limited. Retrying with RoProxy: {roproxy_url}"
                            )
                            async with session.get(
                                roproxy_url, timeout=aiohttp.ClientTimeout(total=10)
                            ) as proxy_response:
                                if proxy_response.status != 200:
                                    logger.error(
                                        f"RoProxy failed: {proxy_response.status}"
                                    )

                            data = await proxy_response.json()

                    users.extend(data["data"])
                    cursor = data.get("nextPageCursor", "")

                    # Calculate stats
                    if total_count:
                        try:
                            percentage: Union[str, float] = (
                                math.ceil((len(users) / total_count * 100) * 100) / 100
                            )
                        except ZeroDivisionError as e:
                            logger.error(f"ZeroDivisionError for role {role_id}: {e}")
                            percentage = "?"
                    else:
                        percentage = "?"

                    if len(users) == total_count and total_count:
                        logger.debug(
                            f"Fetched all {total_count} users for role {role_id}."
                        )
                        percentage = 100.0

                    current_time = time.time()
                    since_last_cycle = current_time - (time_start + elapsed_time)
                    elapsed_time = current_time - time_start

                    try:
                        users_per_sec = (
                            math.ceil(len(data["data"]) / since_last_cycle * 10) / 10
                        )
                    except ZeroDivisionError:
                        users_per_sec = "?"

                    average_users_per_sec = (
                        math.ceil(len(users) / elapsed_time * 10) / 10
                    )

                    estimated_remaining_time = "?"
                    try:
                        users_remaining = total_count - len(users) if total_count else 0
                        estimated_remaining_time = (
                            time.strftime(
                                "%H:%M:%S",
                                time.gmtime(
                                    float(users_remaining)
                                    / float(average_users_per_sec)
                                ),
                            )
                            + " "
                        )
                    except (ZeroDivisionError, ValueError):
                        estimated_remaining_time = "?"

                    # Update the SAME progress task
                    progress.update(
                        task,
                        completed=len(users),
                        ups=f"{users_per_sec}",
                        time_remaining=estimated_remaining_time,
                    )

                    if not cursor:
                        break

            except Exception as e:
                logger.error(f"Error fetching users for role {role_id}: {e}")
                break

    logger.info(
        f"{role_id}: Completed fetching. We have {len(users)} users for role {role_id}."
    )
    return users


async def to_file_discord(content: str, name: str):
    try:
        # Convert the text content into a file-like object
        file_content = BytesIO(content.encode("utf-8"))
        file_content.seek(0)  # Reset the pointer to the start of the file

        # Create a Discord file object
        discord_file = discord.File(file_content, filename=name)

    except Exception as e:
        logger.error(f"Error creating Discord file: {e}")


@bot.slash_command(name="rinse_test", description="Test the bot's response time.")
async def fling_test(interaction: discord.Interaction):
    received_rough = time.monotonic()

    # Defer the response so you can edit it later
    await interaction.response.defer(ephemeral=True)

    before = time.monotonic()
    # Simulate some processing delay (optional)
    await interaction.edit_original_response(content="Pinging...")
    after = time.monotonic()

    latency = round((after - before) * 1000)
    await interaction.edit_original_response(
        content=f"🧼 Foam response time: {latency} ms\nRequest received at {time.gmtime(received_rough)} sec — suds flow optimal 🫧"
    )

    logger.info("Fling test command executed successfully.")


