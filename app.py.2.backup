async def monitor_role_changes(disallowed_rank_names: Optional[list] = None):
    global LOOP_COUNT, AWAITING_SHUTDOWN, shutdown_scheduled, csv_jdplus_str
    LOOP_COUNT += 1

    print(
        f"The TIME_TRACKING_CHANNEL_ID is: {TIME_TRACKING_CHANNEL_ID} and its type is {type(TIME_TRACKING_CHANNEL_ID)}"
    )

    # assert TIME_TRACKING_CHANNEL_ID is int, "TIME_TRACKING_CHANNEL_ID must be an integer."

    asyncio.create_task(
        safe_send(
            f"🧼 Starting a new monitoring loop... All alright I think? *informs <@1114892999474815126>*\n-# disallowed_rank_names: ``{disallowed_rank_names}``",
            TIME_TRACKING_CHANNEL_ID,
        )
    )

    async with aiohttp.ClientSession() as session:
        # file_path = "pickup_last_checking.txt"

        # pickup = False
        # pickup_rank = ""
        # if os.path.exists(file_path):
        #     with open(file_path, "r", encoding="utf-8") as f:
        #         last_checking = f.read().strip()
        #         logger.info(f"Last checking was at: {last_checking}")
        #         pickup = True
        #         pickup_rank = last_checking
        # else:
        #     print(f"{file_path} does not exist.")

        # if (
        #     pickup
        #     and disallowed_rank_names
        #     and str(pickup_rank) in disallowed_rank_names
        # ):
        #     pickup = False

        while True:
            times = {}
            start_time = time.time()
            logger.info("🔎 Checking for role changes...")

            csv_jdplus_str_in_progress = ""

            logger.info("Fetching roles from Roblox API...")
            roles = await fetch_roles(session, GROUP_ID)
            if not roles:
                logger.debug(
                    "No roles found or failed to fetch roles. Retrying in 10 seconds..."
                )
                await asyncio.sleep(10)
                continue

            logger.debug(f"Fetched {len(roles)} roles from Roblox API.")

            # print(f"\n\n{disallowed_rank_names}\n{roles}\n\n")

            if disallowed_rank_names:
                logger.debug(
                    "Removing roles from fetched list so only goes through the restricted role."
                )
                # iterate over role names directly
                for role_name in disallowed_rank_names:
                    # find the role object in roles that matches this name
                    roles = [r for r in roles if r["name"] != role_name]

                logger.debug(
                    f"Removed roles to restricted set of roles. \nRestricted for:{disallowed_rank_names}\nWe have {roles}"
                )

            all_changes_loop = {}

            roles_dict = {role["id"]: role["name"] for role in roles}
            data = await load_data()

            roles_processed = 0
            users_checked = 0

            logger.debug("Starting role change checks, for-loop for roles.")
            total_roles = len(roles)
            for i_roles, role in enumerate(roles, start=1):
                #     # if not pickup:
                #         # break

                #     if role["name"] != pickup_rank and not pickup:
                #         logger.info(
                #             f"Skipping role {role['name']} until we reach pickup."
                #         )
                #         continue
                #     else:
                #         logger.info(
                #             f"Reached pickup rank: {pickup_rank}. Resuming checks."
                #         )
                #         pickup = False

                #         try:
                #             # Remove the pickup file after reaching the rank
                #             if os.path.exists(file_path):
                #                 os.remove(file_path)
                #                 logger.info(f"Removed pickup file: {file_path}")
                #         except Exception as e:
                #             logger.error(f"Error removing pickup file: {e}")

                cur_role_start = time.monotonic()

                with open("pickup_last_checking.txt", "w", encoding="utf-8") as f:
                    f.write(role["name"])

                all_changes_role = []

                logger.info(
                    f"Starting the loop for {role['name']} with ID {role['id']}."
                )

                await bot.change_presence(
                    activity=discord.Game(f"Monitoring role changes: {role['name']}")
                )

                # Queued send - queue messages to max chars to limit messages sent.
                enable_queued_send = role["name"] not in HIGH_RANKS
                queue = ""

                logger.debug(
                    f"Fetching users for role {role['name']} with ID {role['id']}."
                )
                users = await fetch_users_in_role(
                    session, GROUP_ID, role["id"], role_member_count=role["memberCount"]
                )
                logger.debug("Starting role change checks, for-loop for users.")
                total_users = len(users)

                for i_users, user in enumerate(users, start=1):
                    logger.debug(
                        f"[U {i_users}/{total_users}] Processing {user['username']} with ID {user['userId']}. [R {i_roles}/{total_roles}]"
                    )

                    user_id = str(user["userId"])
                    current_rank = role["name"]
                    current_index = get_rank_index(current_rank)

                    if role["name"] in HIGH_RANKS:
                        include_comma = "" if csv_jdplus_str_in_progress == "" else ","
                        csv_jdplus_str_in_progress = (
                            f"{csv_jdplus_str_in_progress}{include_comma}{user_id}"
                        )
                        logger.debug(
                            f"Added {user['username']} ({user_id}) to Junior Director+ CSV string."
                        )
                        logger.debug(
                            f"Current CSV string length: {len(csv_jdplus_str_in_progress)}"
                        )

                    if user_id in data["user_roles"]:
                        prev_role_id = data["user_roles"][user_id]
                        prev_role_name = roles_dict.get(prev_role_id, "Unknown")
                        prev_index = get_rank_index(prev_role_name)

                        # logger.debug(f"Promotion Check: {user["username"]}")
                        # logger.debug(f"has_proper_rank_index  {current_index != -1}")
                        # logger.debug(f"prev_rank_proper_index {prev_index != -1}")
                        # logger.debug(f"Changes: {current_index != prev_index}")

                        if (
                            current_index != -1
                            and prev_index != -1
                            and current_index != prev_index
                        ):

                            action = (
                                "promoted" if current_index > prev_index else "demoted"
                            )
                            channel_id, mention = get_rank_category_and_mention(
                                current_rank
                            )

                            # log_in_mt_too = False
                            prev_channel_id, prev_mention = (
                                get_rank_category_and_mention(prev_role_name)
                            )

                            if (
                                prev_channel_id == JUNIOR_DIRECTOR_CHAIRMAN_CHANNEL
                                and action == "demoted"
                            ):
                                channel_id = JUNIOR_DIRECTOR_CHAIRMAN_CHANNEL

                            if channel_id:
                                channel = bot.get_channel(channel_id)
                                channel_name = getattr(channel, "name", "N/A")

                                del channel

                                # if not isinstance(channel, discord.TextChannel):
                                #     channelid = ""

                                #     if channel is not None and hasattr(channel, "id"):
                                #         channelid = channel.id

                                #     logger.exception(
                                #         f"Channel {channelid} is not a TextChannel."
                                #     )

                                # if True or isinstance(channel, (discord.TextChannel)):
                                profile_link = f"[{user['username']}](<https://www.roblox.com/users/{user['userId']}/profile>)"
                                message = f"{profile_link} has been {action} from {prev_role_name} to {current_rank} {mention}"

                                message_obj = None

                                if enable_queued_send:
                                    if len(queue) + len(message) > MAX_CHARS_DISCORD:
                                        logger.info(
                                            f"📢 Releasing (aka sending) queued message to {channel_name} ({channel_id})"
                                        )
                                        asyncio.create_task(
                                            safe_send(queue, channel_id=channel_id)
                                        )
                                        asyncio.create_task(changes_txt(queue))
                                        queue = ""
                                    queue += message + "\n"
                                    logger.debug(f"Queued message: {message}")

                                    if user == users[-1]:
                                        asyncio.create_task(
                                            safe_send(queue, channel_id=channel_id)
                                        )

                                else:
                                    asyncio.create_task(
                                        safe_send(message, channel_id=channel_id)
                                    )
                                    asyncio.create_task(changes_txt(message))

                                logger.info(f"📢 {message}")

                                if channel_id == JUNIOR_DIRECTOR_CHAIRMAN_CHANNEL:
                                    asyncio.create_task(
                                        safe_publish(
                                            int(getattr(message_obj, "id", None)),
                                            channel_id=channel_id,
                                        )
                                    )

                                rank_map = {
                                    **dict.fromkeys(LOW_RANKS, "Low"),
                                    **dict.fromkeys(MID_RANKS, "Mid"),
                                    **dict.fromkeys(HIGH_RANKS, "High"),
                                }

                                staff_team = rank_map.get(current_rank, "Unknown")

                                change = {
                                    "user": user["username"],
                                    "userId": user["userId"],
                                    "action": action,
                                    "from": prev_role_name,
                                    "to": current_rank,
                                    "mention": mention,
                                    "message_id": getattr(message_obj, "id", None),
                                    "channel_id": channel_id,
                                    "timestamp_discovered_change": time.time(),
                                    "staff_team": staff_team,
                                }

                                # asyncio.create_task(user_rank_history.update_user_history(
                                #     str(user_id), change
                                # ))

                                all_changes_loop.setdefault(staff_team, []).append(
                                    change
                                )
                                all_changes_role.append(change)
                                # else:
                                #     logger.exception(
                                #         f"Channel {getattr(channel, 'name', None)} ({getattr(channel, 'id', None)}) is not a TextChannel or NewsChannel."
                                #     )
                    data = await load_data()
                    data["user_roles"][user_id] = role["id"]
                    users_checked += 1
                    await save_data(data)

                    # asyncio.create_task(user_rank_history.ensure_user_exists(user_id, user["username"], current_rank))
                roles_processed += 1
                cur_role_end = time.monotonic()
                cur_role_time_taken = cur_role_end - cur_role_start
                times[role["name"]] = cur_role_time_taken

            # data = await load_data()
            # await save_data(data)
            end_time = time.time()
            duration = end_time - start_time

            with open(
                "app_changes_log.json", "w", encoding="utf-8"
            ) as changes_log_file:
                json.dump(
                    all_changes_loop,
                    changes_log_file,
                    ensure_ascii=False,
                    indent=2,
                )

            summary = (
                f"## 📊 **Cycle Summary**\n"
                f"* ✅ Processed {roles_processed}/{len(roles)} roles.\n"
                f"* 👥 Checked **{users_checked}** user entries.\n"
                f"* ⏱ Time taken: **{duration:.2f} seconds**.\n"
                f"* 🕐 Started at <t:{int(start_time)}:T>, ended at <t:{int(end_time)}:T>.\n"
                f"* This loop is disallowed for ``{str(disallowed_rank_names)}``\n"
                "-# Ping: <@1114892999474815126>"
            )
            # time_channel = bot.get_channel(TIME_TRACKING_CHANNEL_ID)
            # if time_channel and isinstance(time_channel, discord.TextChannel):
            #     asyncio.create_task(safe_send(summary, channel=time_channel))
            asyncio.create_task(safe_send(summary, channel_id=TIME_TRACKING_CHANNEL_ID))

            file_path = "pickup_last_checking.txt"

            if os.path.exists(file_path):
                os.remove(file_path)
                print(f"{file_path} has been deleted.")
            else:
                print(f"{file_path} does not exist.")
            pickup = False

            logger.info(f"✅ Cycle complete. {duration:.2f} seconds taken.")

            # print("\n"+csv_jdplus_str_in_progress+"\n")

            csv_jdplus_str = csv_jdplus_str_in_progress
            csv_jdplus_str_in_progress = ""

            logger.debug(times)

            latest_app_hash = hashlib.sha256(open("app.py", "rb").read()).hexdigest()

            # with open("app_changes_log.json", "w", encoding="utf-8") as changes_log_file:
            #     json.dump(all_changes_loop, changes_log_file, ensure_ascii=False, indent=2)
            # Hiya +345787877878787878787

            shutdown_scheduled = False

            if AWAITING_SHUTDOWN:
                shutdown_scheduled = True
                logger.info(
                    "Already awaiting shutdown. Proceeding to close bot for this instance of loop..."
                )

            if latest_app_hash != APP_FILE_HASH:
                logger.info("App file has changed. Restarting bot...")
                shutdown_scheduled = True
                # time_channel = bot.get_channel(TIME_TRACKING_CHANNEL_ID)
                # if time_channel and isinstance(time_channel, discord.TextChannel):
                #     asyncio.create_task(
                #         safe_send(
                #             f"# 🔄 App file changed, bot will shutdown. \n We are at the end of the monitor role changes loop, will shutdown...",
                #             channel
                #         ),
                #     )

                await safe_send(
                    f"# 🔄 App file changed, bot will shutdown. \n We are at the end of the monitor role changes loop, will shutdown...",
                    TIME_TRACKING_CHANNEL_ID,
                )

                AWAITING_SHUTDOWN = True

            if shutdown_scheduled:
                logger.info("Shutdown scheduled. Checking for other loops...")
                if LOOP_COUNT == 1:
                    logger.info("This is the only loop. Proceeding to close bot...")
                else:
                    logger.info(f"There are {LOOP_COUNT} loops...")
                    logger.info("Setting AWAITING_SHUTDOWN to True...")
                    LOOP_COUNT -= 1
                    AWAITING_SHUTDOWN = True
                    logger.info("Exiting this monitor loop without closing bot...")
                    return True

                await bot.close()
                logger.info("Bot closed successfully.")
                return True

            if not sys.platform == "win32":
                await asyncio.sleep(180)  # Check every 3 minutes


async def safe_monitor_wrapper(disallowed_rank_names=None):
    quit_func = None
    while True:
        try:
            quit_func = await monitor_role_changes(disallowed_rank_names)
        except (KeyboardInterrupt, SystemExit):
            logger.info("Shutdown signal received. Exiting monitor loop.")
            logger.info("saving data before exit...")
            await save_data(data)
            break
        except Exception as e:
            logger.error(f"‼️ monitor_role_changes crashed: {e}")
            await asyncio.sleep(10)
        # finally:
        if quit_func:
            logger.info(
                "Exiting safe monitor wrapper as monitor_role_changes returned quit=True."
            )

            sys.exit(0)


async def test_single_channel_send_publish(
    channel: Union[discord.TextChannel, discord.abc.GuildChannel, int],
) -> Tuple[bool, Optional[discord.Message]]:
    """Send a test message to a single channel or channel ID.
    Returns (success, discord.Message if success else None).
    """
    chan = bot.get_channel(channel) if isinstance(channel, int) else channel
    if not chan or not hasattr(chan, "send"):
        logger.error(
            "Single channel test: Channel %s invalid or cannot send.",
            getattr(chan, "id", channel),
        )
        return False, None

    success, msg = await safe_send(
        f"-# Testing bot message permissions... ({getattr(chan, 'name', 'N/A')}).",
        channel_id=chan.id,
        silent=True
    )

    if msg is None or success is False:
        logger.error(
            "Single channel test: Failed to send to %s (%s).",
            chan.id,
            getattr(chan, "name", "N/A"),
        )
        return False, None

    logger.info(
        "Single channel test: Sent test message to %s (%s).",
        chan.id,
        getattr(chan, "name", "N/A"),
    )

    # Attempt to publish if it's a NewsChannel
    if isinstance(chan, discord.TextChannel) and chan.type == discord.ChannelType.news:
        publish_result = await safe_publish(int(msg.id), channel_id=chan.id)
        if publish_result:
            logger.info(
                "Single channel test: Published message in NewsChannel %s (%s).",
                chan.id,
                getattr(chan, "name", "N/A"),
            )
        else:
            logger.error(
                "Single channel test: Failed to publish in NewsChannel %s (%s).",
                chan.id,
                getattr(chan, "name", "N/A"),
            )

    try:
        if not chan.type == discord.ChannelType.news:
            await msg.delete()
            logger.info(
                "Single channel test: Deleted test message in %s (%s).",
                chan.id,
                getattr(chan, "name", "N/A"),
            )
    except Exception as e:
        logger.error(
            f"Single channel test: Failed to delete test message in {chan.id} ({getattr(chan, 'name', 'N/A')}): {e}"
        )

    return True, msg


async def test_channel_send_publish(
    channel_ids: Optional[Iterable[int]] = None,
    channel: Union[discord.TextChannel, discord.abc.GuildChannel, int, None] = None,
) -> list[Tuple[bool, Optional[discord.Message]]]:
    """Send test messages to multiple channels or IDs.
    Returns a list of (success, discord.Message).
    """
    targets: list[Union[int, discord.abc.GuildChannel]] = []

    if channel:
        targets.append(channel)

    if channel_ids:
        targets.extend(channel_ids)

    results: list[Tuple[bool, Optional[discord.Message]]] = []
    for target in targets:
        success, msg = await test_single_channel_send_publish(target)
        results.append((success, msg))

    return results

async def test_data_file_operations():
    """Test simplification and unsimplification of data file operations."""
    test_data: Dict[str, Union[int, str, dict]] = {
        "user_roles": {"12345": 1, "67890": 2},
    }

    await save_data(test_data)
    loaded_data = await load_data()

    logger.debug(f"Test data: {test_data}")
    logger.debug(f"Loaded data: {loaded_data}")
    assert test_data["user_roles"] == loaded_data["user_roles"], "Data mismatch after save/load operations."

    logger.info("Data file operations test passed successfully.")
    return True


# Your fixed list of channel IDs
list_of_channels = [
    TIME_TRACKING_CHANNEL_ID,
    CUSTOMER_HEAD_OP_CHANNEL,
    SHIFT_LEADER_GEN_MANAGER_CHANNEL,
    JUNIOR_DIRECTOR_CHAIRMAN_CHANNEL,
]


@bot.slash_command(
    name="test_publish", description="Test publishing to one or all channels"
)
@discord.guild_only()
@discord.commands.option(
    "channel",
    description="Choose 'all' or a specific channel ID",
    choices=[discord.OptionChoice(name="all", value="all")]
    + [
        discord.OptionChoice(name=f"Channel ({cid})", value=str(cid))
        for cid in list_of_channels
    ],
)
async def test_publish(interaction: discord.Interaction, channel: str):
    await interaction.response.defer(ephemeral=True)
    if channel == "all":
        results = []
        for cid in list_of_channels:
            success, msg = await test_single_channel_send_publish(cid)
            results.append(f"{'✅' if success else '❌'} <#{cid}>")
        await interaction.followup.send("\n".join(results))
    else:
        cid = int(channel)
        success, msg = await test_single_channel_send_publish(cid)
        await interaction.followup(
            content=f"{'✅' if success else '❌'} <#{cid}> — {msg}"
        )


@bot.event
async def on_ready():
    global data
    get_latest_git_commitid = None
    try:
        import get_latest_git_commitid
    except (ImportError, NameError) as e:
        logger.error(
            f"Failed to import get_latest_git_commitid: {e}\n You may ignore this error."
        )

    if not bot.user:
        logger.error("Bot user is not set. Exiting.")
        sys.exit(1)

    logger.info(f"Logged in as {bot.user.name}")
    
    logger.info(f"\n\nCopyright (c) 2023-{datetime.date.today().year} Rankspy (Washiez Variant) by Washiez Wiki Bot Developers")
    logger.info("Rankspy by Washiez Wiki Bot Developers, based on original work from MartinAstrea.")
    logger.info("Made with 🧼🫧  by WW:BD, Martin and MrT! Licensed under MIT License until further revision.\n")
    
    await bot.change_presence(activity=discord.Game("Monitoring role changes"))
    try:
        # load persisted data now that the bot loop is running
        data = await load_data()
    except Exception as e:
        logger.error(f"Failed to load data in on_ready: {e}")
        data = {"user_roles": {}}

    try:
        # Quick testing: sync to a guild so commands appear immediately (replace GUILD_ID)
        GUILD_TEST_ID = int(os.getenv("TEST_GUILD_ID", 0))
        if GUILD_TEST_ID:
            await bot.sync_commands(guild=discord.Object(id=GUILD_TEST_ID))
            print("Guild command tree synced for testing.")
        # Global sync (may take up to an hour to propagate)
        # await bot.process_commands()
        await bot.sync_commands()
        print("Command tree synced globally!")
    except Exception as e:
        print(f"Failed to sync command tree: {e}")
    
    await test_data_file_operations()
    
    await store.start_worker()

    # Load structured data
    data = await store.load_data()
    print("Loaded:", data)

    await store.stop_worker()

    list_of_channels = [
        TIME_TRACKING_CHANNEL_ID,
        CUSTOMER_HEAD_OP_CHANNEL,
        SHIFT_LEADER_GEN_MANAGER_CHANNEL,
        JUNIOR_DIRECTOR_CHAIRMAN_CHANNEL,
    ]

    await test_channel_send_publish(list_of_channels)

    del list_of_channels

    if hasattr(bot.get_channel(TIME_TRACKING_CHANNEL_ID), "send"):
        await bot.get_channel(TIME_TRACKING_CHANNEL_ID).send(
            "🧼 Bot is now online and ready to monitor role changes!"
        )

    logger.info("Starting monitor_role_changes task restricted to HO+...")
    all_lower_HO = []
    all_lower_HO.extend(LOW_RANKS)
    all_lower_HO.remove("Head Operator")
    bot.loop.create_task(safe_monitor_wrapper(all_lower_HO))

    # logger.info("Starting monitor_role_changes task...")
    # bot.loop.create_task(safe_monitor_wrapper())
    # logger.info(
    #     "Starting monitor_role_changes restricted to High Ranks (MGMT+) & Middle Ranks (ST) only."
    # )
    # bot.loop.create_task(safe_monitor_wrapper(LOW_RANKS))

    # logger.info("Running monitor_role_changes restricted to Entry Team.")
    # all_except_ET = []
    # all_except_ET.extend(MID_RANKS)
    # all_except_ET.extend(HIGH_RANKS)
    # print(all_except_ET)
    # bot.loop.create_task(safe_monitor_wrapper(all_except_ET))

    # bot.loop.create_task(user_rank_history.history_writer())


