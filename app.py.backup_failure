async def safe_monitor_wrapper(disallowed_rank_names=None):
    quit_func = None
    while True:
        try:
            quit_func = await monitor_role_changes(disallowed_rank_names)
        except (KeyboardInterrupt, SystemExit):
            logger.info("Shutdown signal received. Exiting monitor loop.")
            logger.info("saving data before exit...")
            await save_data(data)
            break
        except Exception as e:
            logger.error(f"‼️ monitor_role_changes crashed: {e}")
            await asyncio.sleep(10)
        # finally:
        if quit_func == True:
            logger.info(
                "Exiting safe monitor wrapper as monitor_role_changes returned quit=True."
            )
            break


